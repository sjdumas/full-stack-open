{
	"name": "bloglist-backend",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"start": "cross-env NODE_ENV=production node index.js",
		"dev": "cross-env NODE_ENV=development node --watch index.js",
		"start:test": "cross-env NODE_ENV=test node --watch index.js",
		"test": "cross-env NODE_ENV=test node --test --test-concurrency=1",
		"lint": "eslint .",
		"build:ui": "rimraf dist && cd ../frontend && npm run build && cpy \"dist/**/*\" \"../backend/dist\"",
		"build": "npm run build:ui",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": "S.J. Dumas",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.7.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"cpy-cli": "^7.0.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"prettier": "3.9.6",
		"rimraf": "^6.1.3",
		"supertest": "^7.2.2"
	}
}
